# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Find them in Supabase: Project Settings → API Keys (and Data API for the URL).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe in the browser; RLS protects the data.
# The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY, bypasses RLS. Needed from M3 (admin tools).
SUPABASE_SECRET_KEY=

# Optional: public URL of the site, used in email links when it can't be detected.
# NEXT_PUBLIC_SITE_URL=https://my-app-zeta-gold-25.vercel.app
